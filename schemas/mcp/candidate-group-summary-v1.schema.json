{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Group of cleanup candidates presented as a cohesive unit for one-decision cleanup.",
  "properties": {
    "active_guard_deferred": {
      "type": "boolean"
    },
    "candidate_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "confirmed_physical_reclaim_bytes": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "description": {
      "type": "string"
    },
    "eligible_for_one_click": {
      "type": "boolean"
    },
    "estimated_reclaim_bytes": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "evidence_level": {
      "type": "string"
    },
    "evidence_reasons": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "group_id": {
      "type": "string"
    },
    "group_type": {
      "type": "string"
    },
    "item_count": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "logical_bytes": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "project_or_app_count": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "group_id",
    "group_type",
    "title",
    "description",
    "item_count",
    "project_or_app_count",
    "logical_bytes",
    "confirmed_physical_reclaim_bytes",
    "estimated_reclaim_bytes",
    "evidence_level",
    "evidence_reasons",
    "candidate_ids",
    "eligible_for_one_click",
    "active_guard_deferred"
  ],
  "title": "CandidateGroupSummaryV1",
  "type": "object"
}
