{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Compact summary of a developer project.",
  "properties": {
    "active_state": {
      "type": "string"
    },
    "all_ecosystems": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "artifacts_count": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "display_name": {
      "type": "string"
    },
    "display_path": {
      "type": "string"
    },
    "primary_ecosystem": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "rebuild_confidence": {
      "type": "string"
    },
    "total_allocated_bytes": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "total_logical_bytes": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "project_id",
    "display_name",
    "display_path",
    "primary_ecosystem",
    "all_ecosystems",
    "artifacts_count",
    "total_logical_bytes",
    "total_allocated_bytes",
    "rebuild_confidence",
    "active_state"
  ],
  "title": "DeveloperProjectSummaryV1",
  "type": "object"
}
