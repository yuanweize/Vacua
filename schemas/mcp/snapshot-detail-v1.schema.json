      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "created_at": {
      "type": "string"
    },
    "logical_bytes": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "root_path": {
      "type": "string"
    },
